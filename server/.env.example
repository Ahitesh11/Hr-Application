# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:3000

# Google Apps Script Web App URL — server-side only.
# Never prefix this with VITE_ or reference it from src/, or it will end up
# in the frontend bundle. This backend is the only thing allowed to call it.
GAS_WEB_APP_URL=

# Google Gemini API key (@google/genai). Server-side only.
GEMINI_API_KEY=
